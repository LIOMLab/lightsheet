# Python virtual environment
.venv/

# Editable-install metadata produced by `pip install -e .`
*.egg-info/

# Rig-specific calibrated config snapshot — captured from the microscope PC over
# SSH by scripts/snapshot-rig-config.sh. Intentionally untracked: holds rig COM
# ports and per-instrument calibration values that must never enter git history.
config.rig-specific.ini

# macOS dev default log directory created by logging_setup.configure().
logs/
.gsd-graph/

# Coverage gate runtime artifacts — produced by scripts/coverage.sh
# (pytest-cov .coverage data file + coverage.json emitted by `coverage json`).
# The gate config itself lives in pyproject.toml and IS tracked; only the
# per-run data output is ephemeral.
.coverage
coverage.json
htmlcov/
